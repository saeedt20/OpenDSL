# /userfs/bin/usb_auto_mount &
# fi
# PRODUCTNAME=`/userfs/bin/tcapi get SysInfo_Entry ProductName`
# OpenDSL boot state neutralisation: begin. webs_rsa_state_upgrade and
# webs_state_error only ever hold "0"/"1" residue of the retired stock online
# updater: this image's guards write no WebCustom_Entry state, and its only
# conceivable writer (the stock online-update helper) is a retired exit-1
# stub, so here can only be residue saved by stock firmware earlier. cfg_manager's
# manual-upload gate treats such a value as an online/signed-upgrade condition
# and would reject the first ordinary local upload ("Download FW Fail" or a
# signature requirement) even though no online-update flow can exist in this
# image. This is retirement cleanup of dead transient state, not a signature
# bypass - cfg_manager's own signature/model/CRC/size checks stay stock and are
# never touched.
# Ordering (recheck D01): the whole block runs BEFORE "/sbin/rc_init &" below,
# which is the only launch path of the startup chain (start_services ->
# start_httpd -> restart_boa.sh), so the GUI cannot serve a firmware upload
# before the cleanup has been attempted to completion.
# Result contract (recheck E01): the shipped /userfs/bin/tcapi ALWAYS exits 0,
# even when the API reports an error; the error class is printed on stdout as
# "connection error" (API/communication failure), "no attribute information"
# (field absent) or "no node information" (configuration node absent). The
# exit status therefore can never prove success here: every call's stdout is
# classified, a GET value counts only when it is exactly empty, "0" or "1",
# and any diagnostic or unexpected text is a failure - never a cleared value.
# Time budget (recheck E02): this target's BusyBox v1.00 has NO "timeout"
# applet (verified against the packed applet table), so each tcapi call runs
# in the background under a usleep/kill/wait deadline of
# OPENDSL_TCAPI_DEADLINE seconds and is reaped before this block ends; no
# owned child can survive to race later GUI activity. Retries are bounded by
# OPENDSL_TCAPI_TRIES, so the whole cleanup has a finite worst-case wall-clock
# budget (under 40 seconds even if every call blocks until its deadline),
# versus an unbounded wait per call in the blocking-API case. On any failure
# or deadline the cleanup fails open: an explicit "OpenDSL:" diagnostic is
# printed and boot continues with whatever live state remains (a surviving
# stale value costs at most one rejected first upload, which stock's validator
# itself clears; it is not permanent lockout).
# Commit semantics: WebCustom has no save/execute callbacks in cfg_manager,
# so the single commit is live-state dispatch only - not a persistent
# configuration-save migration. No "tcapi save" is ever called here.
OPENDSL_TCAPI_DEADLINE=2
OPENDSL_TCAPI_TRIES=2
OPENDSL_TCAPI_TMP=/tmp/opendsl-updater-state.$$

opendsl_tcapi_run() {
	# $1 verb, $2 node, $3 attr, [$4 value]. Prints the CLI's stdout data
	# verbatim, or "ERR:<class>" where class is one of:
	#   timeout        the call exceeded OPENDSL_TCAPI_DEADLINE and was killed
	#   comm           stdout was exactly "connection error"
	#   missingattr    stdout was exactly "no attribute information"
	#   missingnode    stdout was exactly "no node information"
	#   exit:<rc>      the process died with a nonzero status
	#   unexpected:<t> nonempty, unclassified output on a SET/COMMIT
	# GET's value domain is validated by the caller, because data and
	# unknown diagnostics are indistinguishable at this layer.
	/userfs/bin/tcapi "$@" > "$OPENDSL_TCAPI_TMP" 2>/dev/null &
	OTR_PID=$!
	OTR_T=0
	while kill -0 "$OTR_PID" 2>/dev/null ; do
		if [ "$OTR_T" -ge "$((OPENDSL_TCAPI_DEADLINE*10))" ] ; then
			kill "$OTR_PID" 2>/dev/null
			wait "$OTR_PID" 2>/dev/null
			echo "ERR:timeout"
			return 0
		fi
		usleep 100000
		OTR_T=$((OTR_T+1))
	done
	wait "$OTR_PID" 2>/dev/null
	OTR_RC=$?
	OTR_OUT=`cat "$OPENDSL_TCAPI_TMP"`
	if [ "$OTR_RC" -ne 0 ] ; then
		echo "ERR:exit:$OTR_RC"
		return 0
	fi
	case "$OTR_OUT" in
		"connection error") echo "ERR:comm" ;;
		"no attribute information") echo "ERR:missingattr" ;;
		"no node information") echo "ERR:missingnode" ;;
		"") echo "" ;;
		*)
			if [ "$1" = "get" ] ; then
				# this block only ever reads the two updater-state fields,
				# whose domain is "", "0" or "1": anything else is
				# unclassifiable text, never a value
				case "$OTR_OUT" in
					0|1) echo "$OTR_OUT" ;;
					*) echo "ERR:unexpected:$OTR_OUT" ;;
				esac
			else
				echo "ERR:unexpected:$OTR_OUT"
			fi ;;
	esac
	return 0
}

opendsl_tcapi_get_checked() {
	# $1 node, $2 attr. Prints a validated GET result: "", "0", "1",
	# ERR:missingattr, ERR:missingnode, ERR:unexpected:<t>, or the last
	# retryable failure (ERR:comm/ERR:timeout/ERR:exit:*). Only transient
	# failures are retried, at most OPENDSL_TCAPI_TRIES times.
	OCG_TRY=0
	while : ; do
		OCG_TRY=$((OCG_TRY+1))
		OCG_OUT=`opendsl_tcapi_run get "$1" "$2"`
		case "$OCG_OUT" in
			""|0|1|ERR:missingattr|ERR:missingnode|ERR:unexpected:*)
				echo "$OCG_OUT"
				return 0 ;;
			*)
				if [ "$OCG_TRY" -ge "$OPENDSL_TCAPI_TRIES" ] ; then
					echo "$OCG_OUT"
					return 0
				fi
				echo "OpenDSL: boot state neutralisation: get $2 transient API failure ($OCG_OUT), retry $OCG_TRY/$OPENDSL_TCAPI_TRIES" >&2
				sleep 1 ;;
		esac
	done
}

opendsl_tcapi_set_checked() {
	# $1 node, $2 attr. Writes an empty value; succeeds only when the CLI
	# returns with no diagnostic text at all.
	OCS_OUT=`opendsl_tcapi_run set "$1" "$2" ""`
	case "$OCS_OUT" in
		"") return 0 ;;
		*) echo "OpenDSL: boot state neutralisation: SET $2 not accepted ($OCS_OUT)" >&2; return 1 ;;
	esac
}

opendsl_clear_updater_state() {
	# $1 attr name. Returns 0 only when the field is PROVEN empty (read-back
	# GET exactly empty) or genuinely absent; 1 when it could not be
	# verified cleared. Sets OPENDSL_DID_CLEAR=1 only on a verified clear.
	OCU_ATTR="$1"
	OCU_VAL=`opendsl_tcapi_get_checked WebCustom_Entry "$OCU_ATTR"`
	case "$OCU_VAL" in
		"")
			echo "OpenDSL: boot state neutralisation: $OCU_ATTR already empty"
			return 0 ;;
		0|1)
			: ;; # stale residue: fall through to the clear path
		ERR:missingattr)
			echo "OpenDSL: boot state neutralisation: $OCU_ATTR attribute absent (nothing stored to clear)"
			return 0 ;;
		ERR:missingnode)
			echo "OpenDSL: boot state neutralisation: cannot clean $OCU_ATTR: configuration node missing"
			return 1 ;;
		ERR:unexpected:*)
			echo "OpenDSL: boot state neutralisation: unexpected GET output for $OCU_ATTR ($OCU_VAL); not treated as cleared"
			return 1 ;;
		ERR:*)
			echo "OpenDSL: boot state neutralisation: API unavailable for $OCU_ATTR ($OCU_VAL); stale state left untouched"
			return 1 ;;
		*)
			echo "OpenDSL: boot state neutralisation: unexpected GET output for $OCU_ATTR ($OCU_VAL); not treated as cleared"
			return 1 ;;
	esac
	if opendsl_tcapi_set_checked WebCustom_Entry "$OCU_ATTR" ; then
		:
	else
		echo "OpenDSL: boot state neutralisation: SET $OCU_ATTR failed; live value left untouched"
		return 1
	fi
	OCU_RB=`opendsl_tcapi_get_checked WebCustom_Entry "$OCU_ATTR"`
	case "$OCU_RB" in
		"")
			echo "OpenDSL: boot state neutralisation: $OCU_ATTR cleared and verified empty"
			OPENDSL_DID_CLEAR=1
			return 0 ;;
		0|1)
			echo "OpenDSL: boot state neutralisation: $OCU_ATTR still $OCU_RB after SET; not verified cleared"
			return 1 ;;
		*)
			echo "OpenDSL: boot state neutralisation: read-back of $OCU_ATTR failed ($OCU_RB); not verified cleared"
			return 1 ;;
	esac
}

OPENDSL_DID_CLEAR=0
OPENDSL_CLEANUP_FAILED=0
if opendsl_clear_updater_state webs_rsa_state_upgrade ; then
	:
else
	OPENDSL_CLEANUP_FAILED=1
fi
if opendsl_clear_updater_state webs_state_error ; then
	:
else
	OPENDSL_CLEANUP_FAILED=1
fi
if [ "$OPENDSL_DID_CLEAR" = 1 ] ; then
	OCM_OUT=`opendsl_tcapi_run commit WebCustom_Entry`
	case "$OCM_OUT" in
		"")
			echo "OpenDSL: boot state neutralisation: WebCustom commit completed (live state only)" ;;
		*)
			echo "OpenDSL: boot state neutralisation: commit failed ($OCM_OUT)" ;;
	esac
fi
if [ "$OPENDSL_CLEANUP_FAILED" = 1 ] ; then
	echo "OpenDSL: boot state neutralisation: cleanup incomplete; boot continues with whatever live state remains; a first local upload may be rejected once (the stock validator clears the state on that rejection)"
fi
rm -f "$OPENDSL_TCAPI_TMP"
unset -f opendsl_tcapi_run opendsl_tcapi_get_checked opendsl_tcapi_set_checked opendsl_clear_updater_state
unset OPENDSL_TCAPI_DEADLINE OPENDSL_TCAPI_TRIES OPENDSL_TCAPI_TMP OPENDSL_DID_CLEAR OPENDSL_CLEANUP_FAILED
unset OTR_PID OTR_T OTR_RC OTR_OUT OCG_TRY OCG_OUT OCS_OUT OCU_ATTR OCU_VAL OCU_RB OCM_OUT
# OpenDSL boot state neutralisation: end.
/sbin/rc_init &

