+/userfs/bin/tcapi set WebCustom_Entry webs_state_error 1
+/userfs/bin/tcapi set WebCustom_Entry webs_state_error_msg "Online updates retired; use a reviewed local firmware image."
+/userfs/bin/tcapi set WebCustom_Entry webs_state_flag 0
+/userfs/bin/tcapi set WebCustom_Entry webs_state_info ""
+/userfs/bin/tcapi set WebCustom_Entry webs_state_info_beta ""
+/userfs/bin/tcapi set WebCustom_Entry webs_state_url ""
+/userfs/bin/tcapi set WebCustom_Entry webs_state_reboot 0
+/userfs/bin/tcapi set WebCustom_Entry webs_state_update 1
+/userfs/bin/tcapi set WebCustom_Entry webs_state_upgrade 1
+/userfs/bin/tcapi set WebCustom_Entry webs_rsa_state_upgrade 1
+exit 1
