From: OpenDSL
Subject: Protect native app restore and permit only shipped static symbols before login

--- a/apps/public/boa-asp/src/request.c
+++ b/apps/public/boa-asp/src/request.c
@@ -1073,10 +1073,24 @@
 		
 }
 
+static int is_public_symbol(const char *url)
+{
+	const char prefix[] = "/opendsl/symbols/";
+	const char *name;
+	size_t len, i;
+	if(!url || strncmp(url, prefix, sizeof(prefix) - 1)) return 0;
+	name = url + sizeof(prefix) - 1;
+	len = strlen(name);
+	if(len <= 4 || strcmp(name + len - 4, ".svg")) return 0;
+	for(i = 0; i < len - 4; ++i)
+		if((name[i] < 'a' || name[i] > 'z') && name[i] != '-') return 0;
+	return 1;
+}
+
 #if !defined(TCSUPPORT_SELF_LOGIN_WINDOW)
